/* Logic:

1. Start from the **left child and right child of the root**.

2. Compare the two nodes:

   * If **both are empty**, they are symmetric.
   * If **only one is empty**, they are not symmetric.
   * If their **values are different**, they are not symmetric.

3. If the values are the same, compare their **opposite children**:

   * Left node's **left child** with right node's **right child**.
   * Left node's **right child** with right node's **left child**.

4. Keep doing the same comparison **recursively** for every pair of mirror nodes.

5. If every pair matches, the tree is **symmetric**.

### Easy way to remember

**Compare → Check NULL → Check value → Compare opposite children.**

Think: **left-left ↔ right-right** and **left-right ↔ right-left**.
*/

class Solution {
private:
    bool check(TreeNode* left, TreeNode* right) {

        // Both nodes are NULL -> they are symmetric
        if (left == nullptr && right == nullptr)
            return true;

        // One node is NULL and the other is not
        if (left == nullptr || right == nullptr)
            return false;

        // Values are different -> not symmetric
        if (left->val != right->val)
            return false;

        // Compare mirror/opposite children
        return check(left->left, right->right) &&
               check(left->right, right->left);
    }

public:
    bool isSymmetric(TreeNode* root) {

        // Empty tree is symmetric
        if (root == nullptr)
            return true;

        // Compare left and right subtrees
        return check(root->left, root->right);
    }
};
