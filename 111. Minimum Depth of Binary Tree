/* Logic:

1. If `root == NULL`, return `0` because there is no node.
2. Recursively find the minimum depth of the **left subtree**.
3. Recursively find the minimum depth of the **right subtree**.
4. If both `left` and `right` are `0`, the current node is a **leaf**, so return its current depth `d`.
5. If the left subtree is empty, we **must** go through the right subtree.
6. If the right subtree is empty, we **must** go through the left subtree.
7. If both subtrees exist, take the smaller of the two depths:

   ```cpp
   min(left, right)
   ```
8. Start from the root with depth `1`.
*/

class Solution {
public:
    // Returns the minimum depth of the subtree rooted at 'root'
    // 'd' represents the current depth of the node
    int solve(TreeNode* root, int d) {

        // If the subtree is empty, there is no valid path
        if (root == nullptr)
            return 0;

        // Find minimum depth in the left subtree
        int left = solve(root->left, d + 1);

        // Find minimum depth in the right subtree
        int right = solve(root->right, d + 1);

        // If both children are NULL, current node is a leaf
        // Therefore, its depth is the minimum depth
        if (left == 0 && right == 0)
            return d;

        // If left subtree is empty,
        // we must take the depth from the right subtree
        if (left == 0)
            return right;

        // If right subtree is empty,
        // we must take the depth from the left subtree
        if (right == 0)
            return left;

        // If both subtrees exist,
        // choose the one with smaller depth
        return min(left, right);
    }

    int minDepth(TreeNode* root) {

        // Root is at depth 1
        return solve(root, 1);
    }
};

