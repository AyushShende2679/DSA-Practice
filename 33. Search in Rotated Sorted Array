// Logic: 
// Initialize two pointers: low at the beginning and high at the end of the array.

// Repeat until the search space becomes empty.

// Find the middle index of the current search range.

// If the middle element is the target, return its index.

// Check whether the left half of the array is sorted.
// If the left half is sorted:
//     - Check if the target lies within this sorted range.
//     - If yes, discard the right half.
//     - Otherwise, discard the left half.

// Otherwise, the right half must be sorted.
// Check if the target lies within this sorted range.
//     - If yes, discard the left half.
//     - Otherwise, discard the right half.

// If the loop ends without finding the target, return -1.

class Solution {
public:
    int search(vector<int>& nums, int target) {
        int n = nums.size();

        // Initialize the search range
        int low = 0, high = n - 1;

        // Perform binary search
        while (low <= high) {

            // Calculate the middle index
            int mid = low + (high - low) / 2;

            // If target is found, return its index
            if (nums[mid] == target)
                return mid;

            // Check if the left half [low...mid] is sorted
            if (nums[low] <= nums[mid]) {

                // If target lies within the sorted left half,
                // search in the left half
                if (nums[low] <= target && target < nums[mid])
                    high = mid - 1;
                else
                    // Otherwise, search in the right half
                    low = mid + 1;
            }

            // Otherwise, the right half [mid...high] is sorted
            else {

                // If target lies within the sorted right half,
                // search in the right half
                if (nums[mid] < target && target <= nums[high])
                    low = mid + 1;
                else
                    // Otherwise, search in the left half
                    high = mid - 1;
            }
        }

        // Target not found
        return -1;
    }
};
