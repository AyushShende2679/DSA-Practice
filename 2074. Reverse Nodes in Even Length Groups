/*
===========================================================
Problem Logic (Read this before the code)
===========================================================

We have to process the linked list in groups of size:

1, 2, 3, 4, ...

Only reverse a group if its ACTUAL length is even.

Example:
1 -> 2 -> 3 -> 4 -> 5 -> 6 -> 7 -> 8

Groups:
[1]
[2,3]
[4,5,6]
[7,8]

Reverse only:
[2,3] -> [3,2]
[7,8] -> [8,7]

===========================================================
How to process one group?
===========================================================

Suppose current group starts from 'curr'.

Step 1:
Count how many nodes actually exist in this group.
(The last group may have fewer nodes.)

-----------------------------------------------------------

Step 2:
Move to the last node of this group.
We need the tail because after this node,
the next group begins.

tail = last node of current group

-----------------------------------------------------------

Step 3:
Save where the next group starts.

nextGroup = tail->next

Without saving this pointer,
the remaining list will be lost.

-----------------------------------------------------------

Step 4:
Cut the current group.

tail->next = NULL

Now this group becomes an independent linked list.

Example:

2 -> 3 -> 4 -> NULL

Remaining:

5 -> 6 -> ...

-----------------------------------------------------------

Step 5:
If group length is even,
reverse this small linked list.

Else,
leave it unchanged.

-----------------------------------------------------------

Step 6:
Reconnect this processed group.

We keep a pointer called prevTail.

prevTail always points to the LAST NODE
of the already processed part.

Example:

Processed:
1 -> 3 -> 2

Current:
4 -> 5 -> 6

prevTail points to node 2.

Attach:

prevTail->next = newHead

-----------------------------------------------------------

Step 7:
Connect the tail of current group
to the next group.

If reversed:

curr becomes the tail.

curr->next = nextGroup

If not reversed:

tail is already the tail.

tail->next = nextGroup

-----------------------------------------------------------

Step 8:
Move forward.

prevTail = last node of processed group

curr = nextGroup

Increase group size.

Repeat until curr becomes NULL.

===========================================================
Pointers Summary
===========================================================

curr
    First node of current group.

tail
    Last node of current group.

nextGroup
    First node after current group.

prevTail
    Last node of the already processed list.

newHead
    Head of current group after processing
    (reversed or unchanged).

===========================================================
Every iteration follows exactly this order:

Count
↓
Find tail
↓
Save next group
↓
Cut group
↓
Reverse if even
↓
Reconnect previous part
↓
Reconnect next part
↓
Move to next group

Never change this order.
===========================================================
*/

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
private:
    int countNodes(ListNode* head, int groupSize) {
        ListNode* temp = head;
        int count = 0;
        while (temp != NULL && count < groupSize) {
            temp = temp->next;
            count++;
        }
        return count;
    }

    ListNode* reverse(ListNode* head) {
        ListNode* temp = head;
        ListNode* prev = NULL;

        while (temp != NULL) {
            ListNode* front = temp->next;
            temp->next = prev;
            prev = temp;
            temp = front;
        }

        return prev;
    }

public:
    ListNode* reverseEvenLengthGroups(ListNode* head) {

        ListNode* curr = head;
        ListNode* prevTail = NULL;
        int groupSize = 1;

        while (curr != NULL) {

            int count = countNodes(curr, groupSize);

            // Find tail of current group
            ListNode* tail = curr;
            for (int i = 1; i < count; i++) {
                tail = tail->next;
            }

            // Save next group
            ListNode* nextGroup = tail->next;

            // Cut current group
            tail->next = NULL;

            ListNode* newHead = curr;

            if (count % 2 == 0) {
                newHead = reverse(curr);
            }

            // Connect previous group
            if (prevTail != NULL)
                prevTail->next = newHead;
            else
                head = newHead;

            // curr becomes tail if reversed,
            // otherwise tail is already the tail
            if (count % 2 == 0) {
                curr->next = nextGroup;
                prevTail = curr;
            } else {
                tail->next = nextGroup;
                prevTail = tail;
            }

            curr = nextGroup;
            groupSize++;
        }

        return head;
    }
};
