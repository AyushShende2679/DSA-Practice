/* Logic

 - For every node, recursively find the **deepest leaf** in its left and right subtrees.
- For each subtree, return two things:
  - the **depth** of its deepest leaf
  - the **LCA** of all deepest leaves at that depth
- Compare the depths of the left and right subtrees:
  - If both depths are equal, the current node is the LCA of the deepest leaves.
  - If the left depth is greater, the LCA lies in the left subtree.
  - If the right depth is greater, the LCA lies in the right subtree.
- Add `1` to the selected depth while returning to the parent.
- Finally, `lcaDeepestLeaves()` returns the LCA stored in the pair.

 ### In one line

 **Find the maximum depth on both sides; if equal, current node is LCA, otherwise move toward the deeper side.**
*/

class Solution {
public:
    // Returns a pair:
    // first  -> depth of the deepest leaf in this subtree
    // second -> LCA of all deepest leaves
    pair<int, TreeNode*> LCA(TreeNode* root) {

        // Base case:
        // If the node is NULL, depth is 0
        // and there is no LCA.
        if (root == nullptr)
            return {0, root};

        // Find the deepest leaf and its LCA
        // in the left subtree.
        auto left = LCA(root->left);

        // Find the deepest leaf and its LCA
        // in the right subtree.
        auto right = LCA(root->right);

        // If both sides have deepest leaves at
        // the same depth, the current node is
        // the LCA of those deepest leaves.
        if (left.first == right.first)
            return {left.first + 1, root};

        // If the left subtree is deeper,
        // the LCA must be in the left subtree.
        else if (left.first > right.first)
            return {left.first + 1, left.second};

        // If the right subtree is deeper,
        // the LCA must be in the right subtree.
        else
            return {right.first + 1, right.second};
    }

    // Returns the smallest subtree containing
    // all the deepest nodes of the tree.
    TreeNode* subtreeWithAllDeepest(TreeNode* root) { 
        return LCA(root).second; 
    }
};

