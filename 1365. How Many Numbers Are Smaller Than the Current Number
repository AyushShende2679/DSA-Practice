/* Logic:

1. Create a frequency array of size `101` and initialize all elements to `0`.
2. Traverse `nums` and count the frequency of each number using `freq[num]++`.
3. Calculate the prefix sum so that `freq[i]` stores the count of numbers less than or equal to `i`.
4. Traverse `nums` again:
   - If `num == 0`, store `0` because no number is smaller than `0`.
   - Otherwise, store `freq[num - 1]`, which gives the count of numbers strictly smaller than `num`.
5. Return the answer array.

Example:

`nums = [8, 1, 2, 2, 3]`

Output: `[4, 0, 1, 1, 3]`

Time complexity: $O(n)$, because the number range is fixed from `0` to `100`.
*/


class Solution {
public:
    vector<int> smallerNumbersThanCurrent(vector<int>& nums) {

        // Create a frequency array
        // Numbers in nums are between 0 and 100
        vector<int> freq(101, 0);

        // Count how many times each number appears
        for (int num : nums) {
            freq[num]++;
        }

        // Calculate prefix sum
        // freq[i] will store the count of numbers <= i
        for (int i = 1; i <= 100; i++) {
            freq[i] += freq[i - 1];
        }

        // Store the number of smaller elements
        vector<int> ans;

        for (int num : nums) {

            // If num is 0, no number can be smaller
            if (num == 0) {
                ans.push_back(0);
            } else {
                // freq[num - 1] gives the count of numbers
                // strictly smaller than num
                ans.push_back(freq[num - 1]);
            }
        }

        // Return the final answer
        return ans;
    }
};
