class Solution {
public:
    int findPeakElement(vector<int>& nums) {
        int n = nums.size();

        // If there is only one element, it is the peak.
        if (n == 1)
            return 0;

        // Check if the first element is a peak.
        if (nums[0] > nums[1])
            return 0;

        // Check if the last element is a peak.
        if (nums[n - 1] > nums[n - 2])
            return n - 1;

        // Search only in the remaining middle part.
        int low = 1, high = n - 2;

        while (low <= high) {
            // Find the middle index.
            int mid = low + (high - low) / 2;

            // If the current element is greater than both neighbors,
            // then it is the peak.
            if (nums[mid - 1] < nums[mid] && nums[mid] > nums[mid + 1])
                return mid;

            // If the array is increasing, move to the right.
            else if (nums[mid] < nums[mid + 1])
                low = mid + 1;

            // Otherwise, move to the left.
            else
                high = mid - 1;
        }

        // This line is never reached for valid inputs.
        return -1;
    }
};
