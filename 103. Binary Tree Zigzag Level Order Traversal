/* Logic:

1. If the tree is empty, return an empty vector.
2. Use a **queue** to perform **BFS (level-order traversal)**.
3. Push the root into the queue.
4. For every level:
   - Store the current queue size `n`, which tells us how many nodes belong to this level.
   - Remove those `n` nodes one by one.
   - Store their values in a temporary vector `temp`.
   - Push their left and right children into the queue.
5. If the current level is **even**, reverse `temp` because zigzag traversal requires right-to-left order on alternate levels.
6. Add `temp` to the result.
7. Repeat until the queue becomes empty.
8. Return the result.

 ### In short

 **BFS + alternate reversal**

```
Level 1 → Left → Right
Level 2 → Right → Left
Level 3 → Left → Right
Level 4 → Right → Left
        ...
```

 The queue handles the **level-by-level traversal**, while `reverse()` changes the direction for alternate levels.
*/

/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left),
 * right(right) {}
 * };
 */

class Solution {
public:
    vector<vector<int>> zigzagLevelOrder(TreeNode* root) {

        // Stores the final zigzag level order traversal
        vector<vector<int>> res;

        // If tree is empty, return an empty result
        if (root == nullptr)
            return res;

        // Queue is used for Breadth First Search (BFS)
        queue<TreeNode*> q;
        q.push(root);

        // Keeps track of the current level number
        int cnt = 0;

        while (!q.empty()) {

            // Stores values of nodes at the current level
            vector<int> temp;

            // Number of nodes present at the current level
            int n = q.size();

            // Move to the next level
            cnt++;

            // Process all nodes of the current level
            for (int i = 0; i < n; i++) {

                // Get the front node and remove it from the queue
                TreeNode* node = q.front();
                q.pop();

                // Add left child to the queue
                if (node->left)
                    q.push(node->left);

                // Add right child to the queue
                if (node->right)
                    q.push(node->right);

                // Store the current node's value
                temp.push_back(node->val);
            }

            // For even levels, reverse the order
            // to create the zigzag pattern
            if (cnt % 2 == 0)
                reverse(temp.begin(), temp.end());

            // Add the current level to the result
            res.push_back(temp);
        }

        // Return the complete zigzag traversal
        return res;
    }
};
