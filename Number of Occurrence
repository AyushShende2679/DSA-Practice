/*
Logic:

1. Since the array is sorted, use Binary Search to find the first and last
   occurrence of the target element.

2. Find the first occurrence:
   - Perform binary search.
   - When the target is found, store its index.
   - Continue searching in the left half to check if there is an earlier
     occurrence.
   - The final stored index will be the first occurrence.

3. Find the last occurrence:
   - Perform binary search again.
   - When the target is found, store its index.
   - Continue searching in the right half to check if there is a later
     occurrence.
   - The final stored index will be the last occurrence.

4. If the first occurrence is not found, the target is not present in the
   array, so the frequency is 0.

5. If the target exists, calculate the frequency using:
   
   Frequency = Last occurrence index - First occurrence index + 1

Example:
Array: [1, 2, 2, 2, 3]
Target: 2

First occurrence = 1
Last occurrence = 3

Frequency = 3 - 1 + 1 = 3

Time Complexity:
- Two binary searches are performed.
- Overall complexity: O(log n)

Space Complexity:
- Only constant extra variables are used.
- O(1)
*/

class Solution {
	private:
	// Finds the first occurrence index of target
	int firstOccurrence(vector<int>& nums, int target, int n) {
		int low = 0, high = n - 1;
		int first = -1; // Stores first occurrence index
		
		// Binary search to find first occurrence
		while (low <= high) {
			int mid = low + (high - low) / 2;
			
			if (nums[mid] == target) {
				first = mid; // Update first occurrence
				high = mid - 1; // Search left side
			}
			else if (nums[mid] < target) {
				low = mid + 1; // Move to right half
			}
			else {
				high = mid - 1; // Move to left half
			}
		}
		
		return first;
	}
	
	// Finds the last occurrence index of target
	int lastOccurrence(vector<int>& nums, int target, int n) {
		int low = 0, high = n - 1;
		int last = -1; // Stores last occurrence index
		
		// Binary search to find last occurrence
		while (low <= high) {
			int mid = low + (high - low) / 2;
			
			if (nums[mid] == target) {
				last = mid; // Update last occurrence
				low = mid + 1; // Search right side
			}
			else if (nums[mid] < target) {
				low = mid + 1; // Move to right half
			}
			else {
				high = mid - 1; // Move to left half
			}
		}
		
		return last;
	}
	
	public:
	int countFreq(vector<int>& arr, int target) {
		int n = arr.size();
		
		// Find first occurrence of target
		int first = firstOccurrence(arr, target, n);
		
		// Target not found
		if (first == -1)
			return 0;
		
		// Find last occurrence of target
		int last = lastOccurrence(arr, target, n);
		
		// Calculate total frequency
		return last - first + 1;
	}
};
