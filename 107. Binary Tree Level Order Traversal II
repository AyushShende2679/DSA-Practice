/* Logic:

 The logic is:

 1. If the tree is empty, return an empty vector.
2. Use a **queue** to perform BFS.
3. Put the root into the queue.
4. While the queue is not empty:
   - Find the number of nodes at the current level.
   - Process exactly those nodes.
   - Store their values in a temporary vector.
   - Add their left and right children to the queue.
   - Add the temporary vector to `res`.
5. BFS gives levels from **top to bottom**.
6. Reverse `res` to get **bottom to top**.
7. Return `res`.

 In short:

```
Queue → BFS → store each level → reverse result → return
```

 The key idea is **`q.size()` tells you how many nodes are in the current level**.
*/

/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left),
 * right(right) {}
 * };
 */

class Solution {
public:
    vector<vector<int>> levelOrderBottom(TreeNode* root) {

        // This will store all levels of the tree
        vector<vector<int>> res;

        // If tree is empty, return empty result
        if (root == nullptr)
            return res;

        // Queue is used for BFS (level-order traversal)
        queue<TreeNode*> q;

        // Start BFS by putting the root into the queue
        q.push(root);

        // Continue until there are no more nodes to process
        while (!q.empty()) {

            // Store values of the current level
            vector<int> temp;

            // Number of nodes currently in the queue
            // These nodes belong to the same level
            int n = q.size();

            // Process all nodes of the current level
            for (int i = 0; i < n; i++) {

                // Get the front node
                TreeNode* node = q.front();

                // Remove it from the queue
                q.pop();

                // If left child exists, add it to the queue
                // It will be processed in the next level
                if (node->left != nullptr)
                    q.push(node->left);

                // If right child exists, add it to the queue
                // It will be processed in the next level
                if (node->right != nullptr)
                    q.push(node->right);

                // Add current node's value to this level
                temp.push_back(node->val);
            }

            // Add the current level to the result
            res.push_back(temp);
        }

        // BFS gives top-to-bottom order.
        // Reverse it to get bottom-to-top order.
        reverse(res.begin(), res.end());

        // Return the final result
        return res;
    }
};
