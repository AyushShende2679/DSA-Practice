/* Logic:

 The idea is to find all the land cells (`1`) that **can reach the boundary**. Those cells are not enclaves.

 1. Create a `visit` matrix to keep track of visited cells.
2. Start DFS from every `1` present on the **boundary**:
   - First row
   - Last row
   - First column
   - Last column
3. During DFS, visit all connected land cells and mark them as visited.
4. After processing all boundary land, traverse the entire grid.
5. If a cell is:
     then it is an **enclave**, because it is land but cannot reach the boundary.
   - `grid[i][j] == 1`
   - `visit[i][j] == 0`
6. Count all such cells and return the count.

 ### In one line

 **Remove/mark all land connected to the boundary; the remaining land cells are enclaves.**

 ### Complexity

 - **Time:** `O(n × m)` — every cell is visited at most once.
- **Space:** `O(n × m)` — for the `visit` matrix and recursive DFS stack.
*/

class Solution {
private:
    // DFS to visit all land cells connected to the given cell
    void dfs(int row, int col, vector<vector<int>>& grid,
             vector<vector<int>>& visit, int n, int m) {

        // Stop if:
        // 1. Cell is outside the grid
        // 2. Cell is water (0)
        // 3. Cell has already been visited
        if (row < 0 || col < 0 || row >= n || col >= m || grid[row][col] == 0 ||
            visit[row][col] == 1)
            return;

        // Mark current land cell as visited
        visit[row][col] = 1;

        // Move up
        dfs(row - 1, col, grid, visit, n, m);

        // Move right
        dfs(row, col + 1, grid, visit, n, m);

        // Move down
        dfs(row + 1, col, grid, visit, n, m);

        // Move left
        dfs(row, col - 1, grid, visit, n, m);
    }

public:
    int numEnclaves(vector<vector<int>>& grid) {

        int n = grid.size();    // Number of rows
        int m = grid[0].size(); // Number of columns

        // visit[i][j] = 1 means the land cell is connected to the boundary
        vector<vector<int>> visit(n, vector<int>(m, 0));

        // ---------------------------------------------------
        // Visit all land cells on the TOP and BOTTOM borders
        // ---------------------------------------------------
        for (int col = 0; col < m; col++) {

            // Top row
            if (grid[0][col] == 1)
                dfs(0, col, grid, visit, n, m);

            // Bottom row
            if (grid[n - 1][col] == 1)
                dfs(n - 1, col, grid, visit, n, m);
        }

        // ---------------------------------------------------
        // Visit all land cells on the LEFT and RIGHT borders
        // ---------------------------------------------------
        for (int row = 0; row < n; row++) {

            // Left column
            if (grid[row][0] == 1)
                dfs(row, 0, grid, visit, n, m);

            // Right column
            if (grid[row][m - 1] == 1)
                dfs(row, m - 1, grid, visit, n, m);
        }

        // ---------------------------------------------------
        // Count land cells that were NOT visited
        //
        // These cells cannot reach the boundary,
        // so they are completely enclosed by water.
        // ---------------------------------------------------
        int count = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (grid[i][j] == 1 && visit[i][j] == 0)
                    count++;
            }
        }

        return count;
    }
};
