/* Logic:

1. Initialize `count = 0` to track the current consecutive 1s and `maxCount = 0` to store the maximum consecutive 1s.
2. Traverse the array using a loop.
3. If the current element is `1`, increment `count`.
4. If the current element is `0`, reset `count` to `0` because the consecutive sequence is broken.
5. After each iteration, update `maxCount = max(maxCount, count)`.
6. Return `maxCount` as the maximum number of consecutive 1s in the array.
*/


class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int n = nums.size(); // Get the size of the array
        int count = 0;       // Tracks current consecutive 1s
        int maxCount = 0;    // Stores maximum consecutive 1s found

        for (int i = 0; i < n; i++) {
            if (nums[i] == 1)
                count++; // Increment count if current element is 1
            else
                count = 0; // Reset count when a 0 breaks the sequence

            // Update the maximum consecutive 1s found so far
            maxCount = max(maxCount, count);
        }

        return maxCount; // Return the maximum consecutive 1s
    }
};
