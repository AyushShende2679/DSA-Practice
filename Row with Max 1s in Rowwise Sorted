/* Logic:
1. Traverse each row one by one.
2. Since every row is sorted, use binary search to find the first occurrence of 1.
3. The number of 1s in that row is:
   total columns - index of first 1.
4. Compare the number of 1s with the maximum found so far.
5. If the current row has more 1s, update the maximum count and row index.
6. Return the index of the row having the maximum number of 1s.
7. In case of a tie, do not update the answer, so the first row is automatically selected.

Time Complexity: O(n log m)
Space Complexity: O(1)
*/

class Solution {
	private:
	
	// Finds the index of the first element >= x
	// Assumes the array is sorted
	int lowerBound(vector<int>& arr, int x) {
		int n = arr.size();
		
		int low = 0;
		int high = n - 1;
		
		// If no element >= x is found, return n
		int ans = n;
		
		while (low <= high) {
			
			// Avoids possible integer overflow
			int mid = low + (high - low) / 2;
			
			// If arr[mid] can be the lower bound,
			// store its index and search on the left
			if (arr[mid] >= x) {
				ans = mid;
				high = mid - 1;
			}
			else {
				// arr[mid] < x, so search on the right
				low = mid + 1;
			}
		}
		
		return ans;
	}
	
	public:
	
	// Returns the index of the row having the maximum number of 1s
	int rowWithMax1s(vector<vector<int>> &arr) {
		
		int n = arr.size(); // Number of rows
		int m = arr[0].size(); // Number of columns
		
		int count_max = 0; // Maximum number of 1s found so far
		int index = -1; // Index of the row with maximum 1s
		
		for (int i = 0; i < n; i++) {
			
			// Find the position of the first 1 in the current row
			int firstOne = lowerBound(arr[i], 1);
			
			// Since the row is sorted:
			// number of 1s = total elements - position of first 1
			int count_ones = m - firstOne;
			
			// Update answer if current row has more 1s
			if (count_ones > count_max) {
				count_max = count_ones;
				index = i;
			}
		}
		
		return index;
	}
};
