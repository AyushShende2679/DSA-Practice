/* Logic : 
1. First, find the size of the array.
2. If the array has only one element, return that element because it is the single non-duplicate number.
3. Check the first element:
4. If the first element is not equal to the second element, return the first element.
5. Check the last element:
6. If the last element is not equal to the second last element, return the last element.
7. Apply binary search between index 1 and n-2.
8. Find the middle element.
9. Check if the middle element is different from both its neighbors:
10. If yes, it is the single element, so return it.
11. If the middle index is even:
12. Compare the middle element with the previous element.
13. If both are equal, the pair is not in the correct position, so the answer is on the left side.
14. Otherwise, the answer is on the right side.
15. If the middle index is odd:
16. Compare the middle element with the previous element.
17. If both are equal, the pair is correct, so the answer is on the right side.
18. Otherwise, the answer is on the left side.
19. Continue this process until the single element is found.
20. Return -1 if no element is found (this case will not occur for valid input).
*/

class Solution {
public:
    int singleNonDuplicate(vector<int>& nums) {
        int n = nums.size();

        // If there is only one element, return it.
        if (n == 1)
            return nums[0];

        // Check if the first element is unique.
        if (nums[0] != nums[1])
            return nums[0];

        // Check if the last element is unique.
        if (nums[n - 1] != nums[n - 2])
            return nums[n - 1];

        // Search between the first and last element.
        int low = 1, high = n - 2;

        while (low <= high) {
            int mid = (low + high) / 2;

            // If middle element is different from both sides,
            // it is the answer.
            if (nums[mid] != nums[mid - 1] && nums[mid] != nums[mid + 1])
                return nums[mid];

            // Check the position of mid.
            // Before the single element, pairs are:
            // even index -> odd index
            // After the single element, this order changes.

            if (mid % 2 == 0) { // mid is even
                if (nums[mid] == nums[mid - 1])
                    // Same element is on the left, so answer is on left side.
                    high = mid - 1;
                else
                    // Pair is correct, so answer is on right side.
                    low = mid + 1;
            } else { // mid is odd
                if (nums[mid] == nums[mid - 1])
                    // Pair is correct, so answer is on right side.
                    low = mid + 1;
                else
                    // Pair is broken, so answer is on left side.
                    high = mid - 1;
            }
        }

        // This will not execute for valid input.
        return -1;
    }
};


