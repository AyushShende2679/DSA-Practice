/*
Logic to Find Minimum in a Rotated Sorted Array (with Duplicates):

If all three values (left, middle, and right) are the same, you cannot tell which side contains the minimum because both sides look identical.
So, remove one element from both ends and continue searching.
If the current search range is strictly sorted (the left value is smaller than the right value),
then the leftmost element is the minimum in this range.
Save it and stop searching.
If the left half is sorted,
then the minimum of that half is its first element.
Save it and search in the right half, because the rotation (and possibly a smaller value) must be there.
Otherwise, the right half is sorted,
which means the rotation lies in the left half.
The middle element could be the minimum, so save it and continue searching in the left half.
*/

class Solution {
public:
    int findMin(vector<int>& nums) {
        int n = nums.size();

        // Initialize binary search boundaries
        int low = 0, high = n - 1;

        // Store the minimum element found so far
        int ans = INT_MAX;

        while (low <= high) {
            // Find the middle index
            int mid = (low + high) / 2;

            // If low, mid, and high are equal,
            // we cannot determine the sorted half.
            // Shrink the search space.
            if (nums[low] == nums[mid] && nums[mid] == nums[high]) {
                ans = min(ans, nums[low]);
                low++;
                high--;
                continue;
            }

            // if current space low and high is sorted then low will be minimum
            // low and high can be equal even if the array is still rotated
            // < guarantees the current search space is strictly sorted; == is
            // ambiguous because duplicates can hide the rotation.
            if (nums[low] < nums[high]) {
                ans = min(ans, nums[low]);
                break;
            }
            // Left half is sorted
            if (nums[low] <= nums[mid]) {
                // The first element of the sorted half
                // is the smallest in this half.
                ans = min(ans, nums[low]);

                // Search in the right half
                low = mid + 1;
            }
            // Right half is sorted (rotation lies in the left half)
            else {
                // Mid could be the minimum element
                ans = min(ans, nums[mid]);

                // Search in the left half
                high = mid - 1;
            }
        }

        // Return the minimum element found
        return ans;
    }
};
