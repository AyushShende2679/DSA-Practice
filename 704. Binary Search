// Binary Search Algorithm : 
// 1. Initialize low = 0 and high = n - 1.
// 2. While low <= high:
//      a. Find mid = low + (high - low) / 2.
//      b. If nums[mid] == target, return mid.
//      c. If nums[mid] < target, search right half:
//             low = mid + 1.
//      d. Otherwise, search left half:
//             high = mid - 1.
// 3. If the loop ends, the target is not present.
// 4. Return -1.

class Solution {
public:
    // Binary Search
    int search(vector<int>& nums, int target) {
        int n = nums.size();

        // Search space is [low, high] (both inclusive)
        int low = 0, high = n - 1;

        // Continue while at least one element remains
        while (low <= high) {

            // Prevents integer overflow compared to (low + high) / 2
            int mid = low + (high - low) / 2;

            // Target found
            if (nums[mid] == target)
                return mid;

            // Target is in the right half
            else if (nums[mid] < target)
                low = mid + 1;

            // Target is in the left half
            else  // nums[mid] > target
                high = mid - 1;
        }

        // Target not found
        return -1;
    }
};
