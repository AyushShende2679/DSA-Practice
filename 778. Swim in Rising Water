/* Logic : 
Approach: Dijkstra's Algorithm

1. Initialize a min-heap to store `{time, {row, col}}` and push the starting cell `(0, 0)` with time `grid[0][0]`.
2. Create a `dist` matrix initialized with `INT_MAX` and set `dist[0][0] = grid[0][0]`.
3. Pop the cell with the minimum required time from the min-heap.
4. If the popped time is greater than `dist[row][col]`, skip the cell because a better path has already been found.
5. If the current cell is the destination `(n-1, m-1)`, return the current time.
6. Explore all four directions: up, right, down, and left. Ignore neighbors that are outside the grid.
7. Calculate the new time as the maximum of the current time and the elevation of the neighboring cell.

`newTime = max(currentTime, grid[r][c])`

8. If `newTime < dist[r][c]`, update the distance and push the neighbor into the min-heap.
9. Repeat until the destination is reached.

### Complexity Analysis

- **Time Complexity:** `O(N * M * log(N * M))`
- **Space Complexity:** `O(N * M)`

### Key Idea

The water level must be at least the maximum elevation encountered along the path. Therefore, we minimize the **maximum elevation along the path**, rather than the sum of elevations or the differences between adjacent cells.
*/

class Solution {
public:
    // {time, {row, col}}
    using p = pair<int, pair<int, int>>;

    int swimInWater(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();

        // Min-heap to process the cell with the minimum required time first
        priority_queue<p, vector<p>, greater<p>> pq;

        // dist[i][j] stores the minimum time required to reach cell (i, j)
        vector<vector<int>> dist(n, vector<int>(m, INT_MAX));

        // Starting cell requires a water level equal to its elevation
        dist[0][0] = grid[0][0];
        pq.push({grid[0][0], {0, 0}});

        // Directions: up, right, down, left
        int delrow[] = {-1, 0, 1, 0};
        int delcol[] = {0, 1, 0, -1};

        while (!pq.empty()) {
            // Get the cell with the minimum required water level
            int time = pq.top().first;
            int row = pq.top().second.first;
            int col = pq.top().second.second;
            pq.pop();

            // Skip outdated entries if a better path was already found
            if (time > dist[row][col])
                continue;

            // If the destination is reached, return the minimum required time
            if (row == n - 1 && col == m - 1)
                return time;

            // Explore all four neighboring cells
            for (int i = 0; i < 4; i++) {
                int r = row + delrow[i];
                int c = col + delcol[i];

                // Check whether the neighbor is inside the grid
                if (r >= 0 && c >= 0 && r < n && c < m) {

                    // Required water level is the maximum elevation
                    // encountered along the path so far
                    int newTime = max(grid[r][c], time);

                    // Update only if this path requires a lower water level
                    if (newTime < dist[r][c]) {
                        dist[r][c] = newTime;

                        // Push the updated time and neighbor into the min-heap
                        pq.push({newTime, {r, c}});
                    }
                }
            }
        }

        // Return the minimum required water level to reach the destination
        return dist[n - 1][m - 1];
    }
};
