/* Logic: 
Sort the array so that stalls are in increasing order.
We need to maximize the minimum distance between any two cows.
So, instead of searching for the stalls directly, binary search on the answer:
low = 1
high = last stall - first stall
Take mid as the minimum distance we are currently testing.
Greedily place cows:
Place the first cow at the first stall.
Move from left to right.
Whenever the current stall is at least mid distance from the last cow, place another cow.
This greedy strategy gives us the maximum number of cows possible for that mid.
If we can place k or more cows, then mid is possible.
Store mid as the answer.
Try a larger distance.
If we cannot place k cows, then mid is not possible.
Try a smaller distance.
Continue until the binary search finishes.
The largest valid mid is the answer.
Complexity:
TC : O(n log n + n log(maxDistance))
SC : O(1)
*/

class Solution {
	private:
	
	// Checks whether we can place at least k cows
	// such that the minimum distance between any two
	// cows is at least 'mid'.
	bool fun(vector<int> &arr, int mid, int k) {
		
		// Place the first cow at the first stall
		int cows = 1;
		int last = arr[0];
		
		// Try to place the remaining cows
		for (int i = 1; i < arr.size(); i++) {
			
			// If the current stall is at least 'mid'
			// distance away from the last placed cow,
			// place a cow here.
			if (arr[i] - last >= mid) {
				cows++;
				last = arr[i];
			}
			
			// If we can place at least k cows,
			// then this minimum distance 'mid' is possible.
			if (cows >= k)
				return true;
		}
		
		// Could not place k cows with minimum distance 'mid'
		return false;
	}
	
	public:
	
	int aggressiveCows(vector<int> &arr, int k) {
		
		int n = arr.size();
		
		// Sort stalls so that we can greedily
		// place cows from left to right.
		sort(arr.begin(), arr.end());
		
		// Minimum possible distance is 1.
		int low = 1;
		
		// Maximum possible distance is between
		// the first and last stall.
		int high = arr[n - 1] - arr[0];
		
		// Stores the best (maximum) minimum distance found.
		int ans = -1;
		
		// Binary search on the answer (minimum distance).
		while (low <= high) {
			
			// Avoids possible integer overflow.
			int mid = low + (high - low) / 2;
			
			// Check whether 'mid' distance is possible.
			int canWePlace = fun(arr, mid, k);
			
			if (canWePlace == true) {
				
				// 'mid' is a valid answer.
				ans = mid;
				
				// Try for an even larger minimum distance.
				low = mid + 1;
				
			} else {
				
				// 'mid' is not possible.
				// Try a smaller distance.
				high = mid - 1;
			}
		}
		
		// Return the maximum possible minimum distance.
		return ans;
	}
};
