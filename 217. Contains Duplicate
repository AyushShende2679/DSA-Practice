/* Logic – 

1. Create an empty `unordered_set` to store elements.
2. Traverse the given array one element at a time.
3. For each element, check whether it already exists in the set using `st.count()`.
4. If the element already exists, return `true` because a duplicate is found.
5. Otherwise, insert the element into the set using `st.insert()`.
6. If the entire array is traversed without finding a duplicate, return `false`.

Key concept: A HashSet stores only unique elements, so we can detect duplicates efficiently without maintaining frequencies.
*/


class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        // Get the size of the array
        int n = nums.size();

        // Create an unordered_set to store unique elements
        unordered_set<int> st;

        // Traverse through the array
        for (int i = 0; i < n; i++) {

            // Check if the current element already exists in the set
            if (st.count(nums[i])) {
                // If it exists, a duplicate is found
                return true;
            }

            // If it doesn't exist, insert it into the set
            st.insert(nums[i]);
        }

        // If no duplicate is found after traversing the array
        return false;
    }
};

