/* Logic:

1. Create an empty vector `res` to store the inorder traversal.
2. Start traversal from the root node.
3. If the current node is `nullptr`, return because there is nothing to traverse.
4. Recursively traverse the **left subtree**.
5. Add the current node's value to `res`.
6. Recursively traverse the **right subtree**.
7. Continue this process for every node.
8. Finally, return `res`.

**Inorder Traversal:**
`Left → Root → Right`

**Time Complexity:** `O(n)` — every node is visited once.

**Space Complexity:** `O(h)` — recursion stack, where `h` is the height of the tree.
*/

/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left),
 * right(right) {}
 * };
 */
class Solution {
public:
    // Helper function to perform InOrder traversal
    // InOrder traversal follows:
    // Left -> Root -> Right
    void inOrder(TreeNode* node, vector<int>& res) {

        // Base case:
        // If the current node is NULL, there is nothing to traverse.
        if (node == nullptr)
            return;

        //  Traverse the left subtree
        inOrder(node->left, res);

        // Visit the current/root node
        res.push_back(node->val);

        // Traverse the right subtree
        inOrder(node->right, res);
    }

    vector<int> inorderTraversal(TreeNode* root) {

        // Vector to store the final InOrder traversal
        vector<int> res;

        // Start traversal from the root node
        inOrder(root, res);

        // Return the completed traversal
        return res;
    }
};
