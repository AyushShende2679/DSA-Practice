/* Logic:

1. Count how many times each task occurs.
2. Put all frequencies into a **max heap**.
3. Always pick the task with the **highest frequency** first.
4. In one round, pick at most **`n + 1` tasks**.
5. After using a task once, **decrease its frequency**.
6. If that task still has remaining occurrences, keep it in a temporary list.
7. After the round ends, put those remaining tasks back into the heap.
8. If tasks are still left, any empty positions in the round are **idle time**.
9. If no tasks are left, don't add idle time at the end.
10. Keep repeating until the heap becomes empty.
*/


class Solution {
public:
    int leastInterval(vector<char>& tasks, int n) {

        //  Count frequency
        unordered_map<char, int> mp;

        for (auto& task : tasks) {
            mp[task]++;
        }

        //  Max heap
        priority_queue<int> pq;

        for (auto [c, count] : mp) {
            pq.push(count);
        }

        int time = 0;

        //  Process cycles
        while (!pq.empty()) {

            vector<int> temp;
            int used = 0;

            // One cycle has at most n + 1 tasks
            for (int i = 0; i < n + 1 && !pq.empty(); i++) {

                int count = pq.top();
                pq.pop();

                count--;

                if (count > 0) {
                    temp.push_back(count);
                }

                used++;
            }

            // Tasks that still have remaining occurrences
            // become available in the next cycle
            for (int count : temp) {
                pq.push(count);
            }

            // If tasks remain, idle time is necessary
            if (!pq.empty()) {
                time += n + 1;
            }
            // Last cycle: don't count unnecessary idle time
            else {
                time += used;
            }
        }

        return time;
    }
};
