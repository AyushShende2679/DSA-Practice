class Solution {
private:
    int solve(int idx, int prev_idx, vector<int>& nums,
              vector<vector<int>>& dp) {

        // Base case: we have processed all elements
        if (idx == nums.size())
            return 0;

        // prev_idx can be -1, so we use prev_idx + 1
        // to convert it into a valid column index.
        // If already calculated, return the stored result.
        if (dp[idx][prev_idx + 1] != -1)
            return dp[idx][prev_idx + 1];

        // Option 1: Do not take the current element
        int len = 0 + solve(idx + 1, prev_idx, nums, dp);

        // Option 2: Take the current element only if:
        // 1. No previous element was selected (prev_idx == -1), or
        // 2. The current element is greater than the previous one.
        if (prev_idx == -1 || nums[idx] > nums[prev_idx])
            len = max(len, 1 + solve(idx + 1, idx, nums, dp));

        // Store the maximum LIS length for this state.
        return dp[idx][prev_idx + 1] = len;
    }

public:
    int lengthOfLIS(vector<int>& nums) {
        int n = nums.size();

        // n rows: idx ranges from 0 to n-1.
        // n+1 columns: prev_idx ranges from -1 to n-1.
        // The +1 shift maps prev_idx = -1 to column 0.
        vector<vector<int>> dp(n, vector<int>(n + 1, -1));

        // Start at index 0 with no previous element selected.
        return solve(0, -1, nums, dp);
    }
};
