// Logic:
// 1. Start from the top-right corner of the matrix.
// 2. Compare the current element with the target.
// 3. If both are equal, the target is found.
// 4. If the current element is smaller than the target,
//    move down because values below are larger.
// 5. If the current element is greater than the target,
//    move left because values on the left are smaller.
// 6. Continue until we find the target or move outside the matrix.
// 7. If we move outside the matrix, the target is not present.
// 8. Time Complexity: O(n + m)
// 9. Space Complexity: O(1)

class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {

        // Get number of rows
        int n = matrix.size();

        // Get number of columns
        int m = matrix[0].size();

        // Start from the top-right corner
        int row = 0, col = m - 1;

        // Continue while we are inside the matrix
        while (row < n && col >= 0) {

            // Target found
            if (matrix[row][col] == target)
                return true;

            // Current element is smaller than target,
            // so move down to a larger value
            else if (matrix[row][col] < target)
                row++;

            // Current element is greater than target,
            // so move left to a smaller value
            else
                col--;
        }

        // Target does not exist in the matrix
        return false;
    }
};
