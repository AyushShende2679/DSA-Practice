/*  Logic:

1. Since the array is a **mountain array**, it first increases and then decreases, so there is exactly one peak element.

2. Apply **Binary Search** on the array.

3. For every middle index (`mid`):

   * If `arr[mid] < arr[mid + 1]`, we are on the **ascending** part of the mountain.

     * Therefore, the peak must be on the **right**.
     * Move `low = mid + 1`.
   * Otherwise, we are either at the **peak** or on the **descending** part.

     * Store `mid` as a possible answer (`res = mid`).
     * Continue searching on the **left** (`high = mid - 1`) to find the first position where the array starts decreasing.

4. When the binary search ends, `res` contains the index of the peak element.
*/

class Solution {
public:
    int peakIndexInMountainArray(vector<int>& arr) {

        int n = arr.size();
        int low = 0, high = n - 1;

        // Stores the current possible peak index
        int res = -1;

        while (low <= high) {

            // Calculate the middle index
            int mid = low + (high - low) / 2;

            // If the next element is greater,
            // we are on the ascending part of the mountain.
            // Hence, the peak lies on the right.
            if (arr[mid] < arr[mid + 1])
                low = mid + 1;

            // Otherwise, we are either at the peak
            // or on the descending part.
            // Store mid as a potential answer and
            // continue searching on the left to find
            // the first position where the slope changes.
            else {
                res = mid;
                high = mid - 1;
            }
        }

        // Return the peak index.
        return res;
    }
};

