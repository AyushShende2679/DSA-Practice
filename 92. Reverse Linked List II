// Logic: 

// If the list is empty or the reversal range has only one node,
// return the original list since no changes are needed.

// Create a dummy node and connect it to the head.
// This helps handle cases where the reversal starts from the first node.

// Move two pointers:
// - One pointer to the node just before the left position.
// - Another pointer to the first node of the sublist to be reversed.

// Store the first node of the sublist.
// After reversal, this node becomes the tail of the reversed sublist.

// Reverse exactly (right - left + 1) nodes
// using the standard linked list reversal technique.

// Connect the node before the sublist
// to the new head of the reversed sublist.

// Connect the tail of the reversed sublist
// to the first node after the reversed portion.

// Return the head of the modified list.

class Solution {
public:
    ListNode* reverseBetween(ListNode* head, int left, int right) {

        // No reversal needed if the list is empty or has only one node
        if (head == nullptr || left == right)
            return head;

        // Create a dummy node to simplify handling when left = 1
        ListNode* dummyNode = new ListNode(0);
        dummyNode->next = head;

        // leftPrev will point to the node just before the 'left' position
        ListNode* leftPrev = dummyNode;

        // curr points to the first node of the sublist to be reversed
        ListNode* curr = head;

        // Move leftPrev and curr to their required positions
        for (int i = 0; i < left - 1; i++) {
            leftPrev = leftPrev->next;
            curr = curr->next;
        }

        // Store the first node of the sublist.
        // After reversal, this becomes the tail of the reversed sublist.
        ListNode* subHeadList = curr;

        // Standard linked list reversal variables
        ListNode* prev = nullptr;

        // Reverse exactly (right - left + 1) nodes
        for (int i = 0; i <= right - left; i++) {
            ListNode* front = curr->next; // Save next node
            curr->next = prev;            // Reverse current node's pointer
            prev = curr;                  // Move prev one step ahead
            curr = front;                 // Move curr to the next node
        }

        // Connect the node before the sublist to the new head
        leftPrev->next = prev;

        // Connect the tail of the reversed sublist
        // to the remaining part of the list
        subHeadList->next = curr;

        // Return the new head of the list
        return dummyNode->next;
    }
};

