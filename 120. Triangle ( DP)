class Solution {
public:
    int minimumTotal(vector<vector<int>>& triangle) {

        // Number of rows in the triangle.
        int n = triangle.size();

        // Initialize DP table with 0.
        vector<vector<int>> dp(n, vector<int>(n, 0));

        // Base case: Copy the last row of the triangle into DP.
        // From the last row, the minimum path sum is the element itself.
        for (int i = 0; i < n; i++)
            dp[n - 1][i] = triangle[n - 1][i];

        // Start from the second-last row and move upwards.
        for (int i = n - 2; i >= 0; i--) {

            // Traverse each valid column in the current row.
            for (int j = i; j >= 0; j--) {

                // Option 1: Move to the element directly below.
                int down = triangle[i][j] + dp[i + 1][j];

                // Option 2: Move diagonally to the bottom-right element.
                int diagonal = triangle[i][j] + dp[i + 1][j + 1];

                // Store the minimum path sum from the current cell.
                dp[i][j] = min(down, diagonal);
            }
        }

        // The minimum path sum starting from the top element.
        return dp[0][0];
    }
};

