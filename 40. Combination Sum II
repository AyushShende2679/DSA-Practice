/* Logic:

 The approach is **Backtracking + Include/Exclude**.

 1. **Sort the array**
   - Sorting puts duplicate elements together.
   - This helps us skip duplicates and avoid duplicate combinations.
2. **Start recursion from index `0`**
   - At every index, we have two choices: **take** or **skip**.
3. **Take the current element**
   - Add `a[idx]` to `temp`.
   - Reduce the target.
   - Move to `idx + 1` because **each element can be used only once**.
   - After recursion, remove the element using `pop_back()`.
4. **Skip duplicates**
   - Since the array is sorted, identical values are adjacent.
   - Before exploring the "not take" branch, skip all duplicates of the current value.
5. **Don't take the current element**
   - Move to the next index without changing the target.
6. **Base cases**
   - If `target == 0`, store the current combination.
   - If `idx` reaches the end or `target < 0`, stop that path.
*/

 **Main idea:** Generate all possible combinations using backtracking, but **use each element only once and skip duplicates** to ensure unique answers.


class Solution {
public:
    vector<vector<int>> res;

    void solve(vector<int>& a, int target, int idx, vector<int>& temp) {

        // If target becomes 0, we found a valid combination
        if (target == 0) {
            res.push_back(temp);
            return;
        }

        // If we reach the end or target becomes negative,
        // this path is not possible
        if (idx >= a.size() || target < 0)
            return;

        // ---------------- TAKE CURRENT ELEMENT ----------------
        // Choose the current element
        temp.push_back(a[idx]);

        // Move to next index because each element
        // can be used only once
        solve(a, target - a[idx], idx + 1, temp);

        // Backtrack: remove the element we just added
        temp.pop_back();

        // ---------------- SKIP DUPLICATES ----------------
        // Since the array is sorted, duplicate elements
        // will be next to each other.
        //
        // Skip duplicate values so that we don't generate
        // the same combination multiple times.
        while (idx + 1 < a.size() && a[idx] == a[idx + 1])
            idx++;

        // ---------------- DON'T TAKE CURRENT ELEMENT ----------------
        // Skip the current element and move to the next
        // different element
        solve(a, target, idx + 1, temp);
    }

    vector<vector<int>> combinationSum2(vector<int>& candidates, int target) {

        // Clear previous results
        res.clear();

        // Sort so that duplicate elements come together
        sort(candidates.begin(), candidates.end());

        vector<int> temp;

        // Start recursion from index 0
        solve(candidates, target, 0, temp);

        return res;
    }
};
